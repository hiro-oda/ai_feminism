# 系統抽出法（systematic sampling）
sys_samp <- function(N, n) {
interval <- floor(N/n)  # floor(5.2) = 5, ceiling(5.2) = 6
start <- sample(1:interval, size = 1)  # 上記の説明とは異なり，1からインターバルの間から1つ数字を選び，スタートの番号とする．
samp <- numeric(length = n)
for (k in 1:n) {
samp[k] <- start + (interval * (k - 1))
}
list(interval = interval, starting_value = start, sample = samp)
}
# 100人から10人選ぶ
set.seed(1234)  #乱数を固定
sys_samp(100,10)
# 系統抽出法（systematic sampling）
sys_samp <- function(N, n) {
interval <- floor(N/n)  # floor(5.2) = 5, ceiling(5.2) = 6
start <- sample(1:interval, size = 1)  # 上記の説明とは異なり，1からインターバルの間から1つ数字を選び，スタートの番号とする．
samp <- numeric(length = n)
for (k in 1:n) {
samp[k] <- start + (interval * (k - 1))
}
list(interval = interval, starting_value = start, sample = samp)
}
