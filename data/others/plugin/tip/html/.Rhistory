# パッケージの読み込み
library(tidyverse)
library(janitor)
# データの読み込み
d <- read_csv("Desktop/social_survey2021/Neo_Tokyo.csv")
# 変数へのラベルづけ
d <- d %>% mutate(gender = factor(Gender,
levels = 1:2,
labels = c("Male", "Female")),
age = factor(Age_ct,
levels = 1:13,
labels = c("15-19","20-24","25-29","30-34","35-39",
"40-44","45-49","50-54","55-59","60-64",
"65-69","70-74","75-")),
working = factor(Work,
levels = 1:2,
labels = c("Working", "Not working"))
)
# 真の世界
tabyl(d$age)
tabyl(d$gender)
# 標本の世界（sample_nを利用．サンプルサイズは n = 500）
d_sample <- sample_n(d, 500, replace = FALSE)
d_sample <- sample_n(d, 500, replace = FALSE)
tabyl(d_sample$age)
tabyl(d_sample$gender)
# グラフで年齢の分布の違いを見る
pop_age_data <- d %>%
group_by(age) %>%
summarise(n = n()) %>%
summarise(age,n,percent = n/sum(n),type = "Population")
samp_age_data <- d_sample %>%
group_by(age) %>%
summarise(n = n()) %>%
summarise(age,n,percent = n/sum(n),type = "Sample")
d_age <- bind_rows(pop_age_data, samp_age_data)
d_age %>%
ggplot(aes(x = age, y = percent, color = type, shape = type, linetype = type, group = type)) +
geom_point() +
geom_line() +
ylim(0,0.2) +
theme_minimal()
samp_age_data <- d_sample %>%
group_by(age) %>%
summarise(n = n()) %>%
summarise(age,n,percent = n/sum(n),type = "Sample")
d_age <- bind_rows(pop_age_data, samp_age_data)
d_age %>%
ggplot(aes(x = age, y = percent, color = type, shape = type, linetype = type, group = type)) +
geom_point() +
geom_line() +
ylim(0,0.2) +
theme_minimal()
